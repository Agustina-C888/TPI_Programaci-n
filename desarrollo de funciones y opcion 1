def validar_nombre(nombre):
    """Devuelve el nombre sin espacios al inicio y al final.
    Si quedan vacío o eran solo espacios, lanza ValueError."""
    nombre=nombre.strip()
    if nombre=="":
        raise ValueError("El nombre no puede estar vacio.")
    return nombre

def buscar_herramienta(inventario , nombre):
    """Busca una herramienta ignorando mayusculas y espacios en los extremos-
    Devuelve el diccionario que ya esta dentro de inventario , o None si no existe."""
    for producto in inventario:
        if producto["herramienta"].lower()==nombre.strip().lower():
            return producto
    return None

def pedir_entero(mensaje):
    """Pide un dato y lo convierte a entero.Si no se puede, lanza ValueError con un mensaje claro.
    """
    try:
        return int(input(mensaje))
    except ValueError:
        raise ValueError("Debe ingresar un numero entero(sin letras ni decimales.)")

