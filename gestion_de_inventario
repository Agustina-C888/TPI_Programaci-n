#opción 1
def cargar_herramientas(inventario):
    cantidad_herramentas = 0

    while cantidad_herramentas <= 0:
        try: 
            cantidad_herramentas = int(input("Ingrese la cantidad de herramientas a cargar: "))
            if cantidad_herramentas <= 0:
                raise ValueError("Debe ingresar un número entero mayor a 0")
            
        except ValueError as e:
            print(f"Error. {e}")
            cantidad_herramentas = 0

    for i in range(1,cantidad_herramentas +1):
        while True:
            nombre_herramienta = input(f"Ingrese el nombre de la {i} herramienta: ").strip().capitalize()
            while not nombre_herramienta.replace(" ","").isalpha():
                print("Error. no ingreso un nombre válido")
                nombre_herramienta = input(f"Ingrese el nombre de la {i} herramienta: ").strip().capitalize()

            nombre_repetido = False
            
            for herramienta in inventario:
                if herramienta["herramienta"].lower() == nombre_herramienta.lower():
                    nombre_repetido = True

            try:
                if nombre_repetido:
                    raise ValueError("La herramienta ya existe.")
                else:
                    break

            except ValueError as e:
                print(f"Error: {e}")

        cantidad_stock = -1

        while cantidad_stock < 0:
            try:
                cantidad_stock = int(input("Ingrese el stock inicial: "))

                if cantidad_stock < 0:
                    raise ValueError("El stock no puede ser negativo.")

            except ValueError as e:
                print(f"Error: {e}")
                cantidad_stock = -1

        inventario.append({
            "herramienta": nombre_herramienta,
            "cantidad": cantidad_stock
        })

    print("Herramientas cargadas correctamente.")

